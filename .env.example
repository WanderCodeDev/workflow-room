# Postgres (npm run db:start creates this local cluster on port 5433)
DATABASE_URL=postgres://postgres@localhost:5433/prospect_room
PORT=3000

# Apollo — the free plan works, but the account must be registered with a work email address.
# Search (mixed_people/api_search) costs 0 credits; enrichment (people/match) costs 1 credit when data is found.
# The key needs both scopes (api/v1/mixed_people/api_search and api/v1/people/match) or set it as a master key.
# Verify it with: npm run apollo:check
APOLLO_API_KEY=
# Point at the local fake to run without a key: http://127.0.0.1:4010/api/v1  (npm run fake-apollo)
APOLLO_BASE_URL=https://api.apollo.io/api/v1
APOLLO_LIMIT_PER_MINUTE=45
APOLLO_LIMIT_PER_HOUR=190
APOLLO_LIMIT_PER_DAY=580

# Drafting: uses Claude when ANTHROPIC_API_KEY is set, otherwise a deterministic template.
ANTHROPIC_API_KEY=
# DRAFTER=template
CLAUDE_MODEL=claude-opus-5

# Worker
WORKER_CONCURRENCY=2
LEASE_SECONDS=30
HEARTBEAT_SECONDS=5
JOB_MAX_ATTEMPTS=8

# LinkedIn headline via Playwright driving real Chrome (npm run linkedin:login once to save a session)
LINKEDIN_ENABLED=true
LINKEDIN_HEADLESS=false
LINKEDIN_BROWSER_CHANNEL=chrome
# LINKEDIN_URL_OVERRIDE=https://www.linkedin.com/in/some-public-profile/
